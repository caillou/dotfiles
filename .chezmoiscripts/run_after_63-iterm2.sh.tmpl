#!/bin/sh
# iTerm2: points iTerm2 at the preferences folder in the repo, so the profile,
# font and colours load from the repo and every change made in iTerm2's UI is
# written back into the repo when iTerm2 quits.
{{ template "facts.sh" . }}
# iTerm2 can arrive after the first apply (Self Service on the managed Mac),
# so a missing iTerm2 is a skip, not a failure.
if ! app_present "iTerm.app"; then
  echo "iterm2: iTerm2 is not installed, skipping. The next \`chezmoi apply\` points iTerm2 at the repo folder."
  exit 0
fi

# The folder sits inside the source directory, so iTerm2 writes straight into
# the repo. iTerm2 excludes these four keys from the preferences it exports
# there, so this machine's path never reaches the committed plist.
PREFS={{ printf "%s/.iterm2" .chezmoi.sourceDir | quote }}

changed=0

# set_default <key> <write type> <write value> <value as `defaults read` prints it>
set_default() {
  if default_is com.googlecode.iterm2 "$1" "$4"; then
    return 0
  fi
  defaults write com.googlecode.iterm2 "$1" "$2" "$3"
  changed=1
}

set_default PrefsCustomFolder -string "$PREFS" "$PREFS"
set_default LoadPrefsFromCustomFolder -bool true 1
# "Save changes automatically" needs both keys: iTerm2 ignores the selection
# unless the reminder flag is set as well.
set_default NoSyncNeverRemindPrefsChangesLostForFile -bool true 1
set_default NoSyncNeverRemindPrefsChangesLostForFile_selection -int 2 2

if [ "$changed" = 0 ]; then
  echo "iterm2: already loading its preferences from $PREFS"
  exit 0
fi

echo "iterm2: preferences folder set to $PREFS"
echo "iterm2: quit and reopen iTerm2 to load it. From then on iTerm2 saves its"
echo "iterm2: settings back into the repo on quit, where they show up as drift."
exit 0
