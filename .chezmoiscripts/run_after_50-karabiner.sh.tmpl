#!/bin/sh
# Karabiner: builds the rules from the karabiner.ts source into Karabiner's config.
{{ template "facts.sh" . }}
# The project lives in the repo, dot-prefixed, so chezmoi never treats it as a
# dotfile. The build runs there and writes into Karabiner's own config file.
SOURCE={{ printf "%s/.karabiner" .chezmoi.sourceDir | quote }}

# karabiner.ts resolves this path itself, from the home directory; the script
# only checks that it is there. Karabiner writes it on first launch.
CONFIG="$HOME/.config/karabiner/karabiner.json"

# The profile the rules file writes into (`writeToProfile` in src/index.ts).
# Karabiner creates it on first launch; karabiner.ts exits 1 when it is gone.
PROFILE="Default profile"

# The preamble puts the asdf shims on PATH, which is where node and npm come
# from. This is the seam a test uses to point the script at a stub.
NPM="${DOTFILES_NPM:-npm}"

# The preamble puts Homebrew on PATH, which is where jq comes from (a core
# formula, so script 10 has installed it). It reads the config file.
JQ="${DOTFILES_JQ:-jq}"

# Karabiner can arrive later: Self Service on the managed Mac, or a deliberate
# install. A missing Karabiner is a skip; the next apply builds the rules.
if ! app_present "Karabiner-Elements.app"; then
  echo "karabiner: Karabiner-Elements is not installed, skipping. The next \`chezmoi apply\` builds the rules."
  exit 0
fi

# The build replaces the rules inside the config file Karabiner wrote and keeps
# everything else in it, so the file has to exist first. It appears on first
# launch, which the manual checklist asks for.
if [ ! -f "$CONFIG" ]; then
  echo "karabiner: Karabiner-Elements has never been launched, so $CONFIG does not"
  echo "karabiner: exist yet. Launch it once. The next \`chezmoi apply\` builds the rules."
  exit 0
fi

if ! has_command "$JQ"; then
  echo "karabiner: jq is not available yet (it comes from Homebrew), skipping. The next \`chezmoi apply\` builds the rules."
  exit 0
fi

# `$name` in the filters below is jq's variable, bound by --arg, not the
# shell's, hence the single quotes.
# profile_exists -> the config file has the profile the rules are written into
profile_exists() {
  # shellcheck disable=SC2016
  "$JQ" -e --arg name "$PROFILE" \
    'any(.profiles[]?; .name == $name)' "$CONFIG" >/dev/null 2>&1
}

# rules_present -> that profile holds at least one complex modification rule
rules_present() {
  # shellcheck disable=SC2016
  "$JQ" -e --arg name "$PROFILE" \
    'any(.profiles[]?; .name == $name and ((.complex_modifications.rules // []) | length > 0))' \
    "$CONFIG" >/dev/null 2>&1
}

# Everything the build reads is the input: the package files, the compiler
# config and every file under src/ (the glob is sorted). The hash is stored
# only after a build succeeded, so a matching hash is also the record of that
# success. The hash alone cannot answer whether the rules are still in the
# config file: Karabiner recreates it on a reinstall, a "restore to default"
# or a restored backup, so the destination is checked too.
hash="$(cd "$SOURCE" && file_hash package.json package-lock.json tsconfig.json src/*)"
if hash_unchanged karabiner "$hash" && rules_present; then
  # Nothing to say on the common path: every apply runs this script.
  exit 0
fi

# Without the profile the build exits 1 after a full `npm ci`, every apply.
# Karabiner owns the file, so the fix is in its UI, not here.
if ! profile_exists; then
  echo "karabiner: $CONFIG has no profile named \"$PROFILE\", which is where the rules go."
  echo "karabiner: Rename or create that profile in Karabiner-Elements. The next \`chezmoi apply\` builds the rules."
  exit 0
fi

# The asdf shim is on PATH before any node is installed, so finding npm is
# not enough: it has to answer, from the project directory, where asdf picks
# the node version.
if ! (cd "$SOURCE" && "$NPM" --version >/dev/null 2>&1); then
  echo "karabiner: npm is not available yet (it comes from the asdf node), skipping. The next \`chezmoi apply\` builds the rules."
  exit 0
fi

# A build must never abort the apply: npm can fail on a flaky network, and a
# broken rules file must not stop the rest of the sync. The hash stays
# unstored, so the next apply builds the rules.
echo "karabiner: building the rules from $SOURCE"

# The dependencies have their own hash, stored after an `npm ci` succeeded, so
# a rules file that fails to build costs an install once, not on every apply.
# `node_modules` can disappear without the package files changing (a clean
# checkout), hence the directory check.
deps_hash="$(cd "$SOURCE" && file_hash package.json package-lock.json)"
if ! { hash_unchanged karabiner-deps "$deps_hash" && [ -d "$SOURCE/node_modules" ]; }; then
  if ! (cd "$SOURCE" && "$NPM" ci </dev/null); then
    echo "karabiner: npm ci failed. The next \`chezmoi apply\` builds the rules."
    exit 0
  fi
  store_hash karabiner-deps "$deps_hash"
fi

if ! (cd "$SOURCE" && "$NPM" run build </dev/null); then
  echo "karabiner: the build failed. The next \`chezmoi apply\` builds the rules."
  exit 0
fi

store_hash karabiner "$hash"
echo "karabiner: rules written into $CONFIG"
exit 0
