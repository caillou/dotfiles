#!/bin/sh
# asdf: adds the plugins and installs the versions pinned in ~/.tool-versions.
{{ template "facts.sh" . }}
# The managed ~/.tool-versions is the only place versions are declared, so this
# script reads it instead of repeating the pins. `asdf set` is never run: it
# writes that file, and the copy in the home directory would drift from the one
# in the repo.
TOOL_VERSIONS="$HOME/.tool-versions"

# The preamble puts ~/.asdf/shims on PATH. This is the seam a test uses to
# point the script at a stub that installs nothing.
ASDF="${DOTFILES_ASDF:-asdf}"

if ! has_command "$ASDF"; then
  echo "asdf: asdf is not installed, skipping. The next \`chezmoi apply\` installs the pinned versions."
  exit 0
fi

if [ ! -f "$TOOL_VERSIONS" ]; then
  echo "asdf: no $TOOL_VERSIONS, nothing to pin"
  exit 0
fi

plugin_added() {
  "$ASDF" plugin list 2>/dev/null | grep -qxF "$1"
}

# `asdf list <plugin>` prints one version per line, indented, with the current
# one marked by an asterisk.
version_installed() {
  "$ASDF" list "$1" 2>/dev/null | tr -d ' *' | grep -qxF "$2"
}

# Is every pinned plugin added and every pinned version installed? The hash
# alone cannot answer that: a version can disappear without the file changing.
all_installed() {
  while read -r plugin version _; do
    case "$plugin" in '' | \#*) continue ;; esac
    [ -n "$version" ] || continue
    plugin_added "$plugin" || return 1
    version_installed "$plugin" "$version" || return 1
  done <"$TOOL_VERSIONS"
}

hash="$(file_hash "$TOOL_VERSIONS")"
if hash_unchanged asdf "$hash" && all_installed; then
  echo "asdf: the pinned versions are installed"
  exit 0
fi

# A plugin add or an install can fail on a flaky network or a missing build
# dependency. That must not abort the apply, so the failure is reported and the
# hash stays unstored, so the next apply installs it.
status=0
while read -r plugin version _; do
  case "$plugin" in '' | \#*) continue ;; esac
  [ -n "$version" ] || continue

  if ! plugin_added "$plugin"; then
    echo "asdf: adding the $plugin plugin"
    "$ASDF" plugin add "$plugin" </dev/null || status=1
  fi

  if ! version_installed "$plugin" "$version"; then
    echo "asdf: installing $plugin $version"
    "$ASDF" install "$plugin" "$version" </dev/null || status=1
  fi
done <"$TOOL_VERSIONS"

# Shims are rewritten on every pass: a new version needs them, and so does the
# migration from the git-clone asdf, whose shims in the same ~/.asdf are stale.
"$ASDF" reshim </dev/null || status=1

if [ "$status" -ne 0 ]; then
  echo "asdf: something did not install. The next \`chezmoi apply\` installs the pinned versions."
  exit 0
fi

store_hash asdf "$hash"
exit 0
