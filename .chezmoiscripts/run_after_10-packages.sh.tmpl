#!/bin/sh
# Packages: renders the Brewfile, appends casks and App Store apps from the table, runs brew bundle.
{{ template "facts.sh" . }}
{{- $groups := list "core" }}
{{- if .personal }}{{ $groups = append $groups "personal" }}{{ end }}
{{- if .embedded }}{{ $groups = append $groups "embedded" }}{{ end }}
# BREWFILE and BREW come from the preamble.
cat >"$BREWFILE" <<'EOF_BREWFILE'
{{ template "Brewfile" . -}}
EOF_BREWFILE
{{ if not .managed }}
# Casks and App Store apps come from .chezmoidata/apps.yaml. They are appended
# here rather than rendered into the template so the check below runs against
# this machine's Applications folder.
#
# A cask is listed when its app bundle is absent, so there is nothing to adopt,
# or when Homebrew installed it (a Caskroom entry exists), so it keeps being
# upgraded and `brew bundle cleanup` still accounts for it. An app that arrived
# by hand is left out: `brew bundle` would otherwise adopt and overwrite it.
CASKROOM="${DOTFILES_CASKROOM:-${HOMEBREW_PREFIX:-/opt/homebrew}/Caskroom}"

add_cask() {
  if [ -n "$2" ] && app_present "$2" && [ ! -d "$CASKROOM/$1" ]; then
    printf 'packages: leaving %s alone, it is installed without Homebrew\n' "$2"
    return 0
  fi
  printf 'cask "%s"\n' "$1" >>"$BREWFILE"
}

printf '\n' >>"$BREWFILE"
{{- range .apps }}
{{- if and (eq .kind "cask") (has .group $groups) }}
add_cask {{ .name | quote }} {{ .app | quote }}
{{- end }}
{{- end }}

cat >>"$BREWFILE" <<'EOF_MAS'
{{- range .apps }}
{{- if and (eq .kind "mas") (has .group $groups) }}
mas "{{ trimSuffix ".app" .app }}", id: {{ .name }}
{{- end }}
{{- end }}
EOF_MAS
{{ end }}
if ! has_command "$BREW"; then
  echo "packages: Homebrew is not installed, skipping. The next \`chezmoi apply\` installs the packages."
  exit 0
fi

hash="$(file_hash "$BREWFILE")"
if hash_unchanged packages "$hash" && [ "$(marker_value packages-status)" = 0 ]; then
  echo "packages: nothing changed since the last successful run"
  exit 0
fi

# brew bundle carries on past a failing entry and reports at the end. A
# signed-out App Store or a flaky download must not abort the apply, so the
# exit code is recorded for the final report instead of propagated.
status=0
"$BREW" bundle --file "$BREWFILE" || status=$?
store_hash packages "$hash"
mark packages-status "$status"

if [ "$status" -ne 0 ]; then
  echo "packages: brew bundle exited $status, see the checklist at the end of this apply"
fi
exit 0
