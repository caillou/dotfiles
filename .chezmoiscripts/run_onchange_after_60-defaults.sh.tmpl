#!/bin/sh
# macOS defaults: pure writer, so chezmoi's change trigger is the right mode.
#
# Every value below was read off a configured Mac; the capture commands are in
# docs/PRDs/2026-09-10-chezmoi-mac-bootstrap/research-notes.md section 3, and
# each -bool/-int/-float mirrors the type macOS itself stored for that key.
#
# Paths come from $HOME, never from template variables, so this file can be
# edited in the home directory and copied back with `chezmoi re-add`.
#
# The order is the whole point: System Settings quits first (it holds its panes
# in memory and writes them back on quit, undoing everything), then every
# write, then activateSettings so the input settings apply without a logout,
# then the three UI processes that cache what was written.
{{ template "facts.sh" . }}
# The private tool that re-reads the input settings. Overridable so a test can
# watch it being called without re-applying anything on the test machine.
ACTIVATE_SETTINGS="${DOTFILES_ACTIVATE_SETTINGS:-/System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings}"

# The system python, not asdf's: this runs before any language toolchain is in
# place, and the Command Line Tools provide it.
PYTHON="${DOTFILES_PYTHON:-/usr/bin/python3}"

# Pointer speed. hidutil reports the live value multiplied by 65536.
POINTER_SPEED=0.6875
POINTER_HID=45056

pointer_speed_now() {
  hidutil property --get HIDPointerAcceleration 2>/dev/null || true
}

# --- System Settings -------------------------------------------------------

osascript -e 'tell application "System Settings" to quit' >/dev/null 2>&1 || true

# What the pointer speed was before this run, for the read-back at the end.
pointer_was="$(pointer_speed_now)"

# --- Keyboard --------------------------------------------------------------

defaults write NSGlobalDomain com.apple.keyboard.fnState -bool true
defaults write com.apple.HIToolbox AppleFnUsageType -int 0
defaults write NSGlobalDomain KeyRepeat -int 2
defaults write NSGlobalDomain InitialKeyRepeat -int 15
defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false
defaults write NSGlobalDomain AppleKeyboardUIMode -int 3
defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false
defaults write NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false

# --- Input sources ---------------------------------------------------------

# One keyboard layout, ABC, plus the two entries macOS lists for itself (the
# emoji palette and dictation); together that is the whole enabled list as read
# off the reference Mac. Each element is an XML fragment: defaults write -array
# parses every element as a plist, and these are dictionaries.
ABC='<dict><key>InputSourceKind</key><string>Keyboard Layout</string><key>KeyboardLayout ID</key><integer>252</integer><key>KeyboardLayout Name</key><string>ABC</string></dict>'
PALETTE='<dict><key>Bundle ID</key><string>com.apple.CharacterPaletteIM</string><key>InputSourceKind</key><string>Non Keyboard Input Method</string></dict>'
DICTATION='<dict><key>Bundle ID</key><string>com.apple.inputmethod.ironwood</string><key>InputSourceKind</key><string>Non Keyboard Input Method</string></dict>'
defaults write com.apple.HIToolbox AppleEnabledInputSources -array "$ABC" "$PALETTE" "$DICTATION"
defaults write com.apple.HIToolbox AppleSelectedInputSources -array "$ABC"
defaults write com.apple.HIToolbox AppleInputSourceHistory -array "$ABC"
defaults write com.apple.HIToolbox AppleCurrentKeyboardLayoutInputSourceID -string com.apple.keylayout.ABC

# The input menu in the menu bar; TextInputMenuAgent draws it and is restarted
# with the other UI processes at the end.
defaults write com.apple.TextInputMenu visible -bool false

# --- Scrolling -------------------------------------------------------------

defaults write NSGlobalDomain com.apple.swipescrolldirection -bool false
defaults write NSGlobalDomain AppleEnableSwipeNavigateWithScrolls -bool false

# --- Trackpad --------------------------------------------------------------

# The built-in trackpad and a Magic Trackpad read different domains and both
# are written, so a paired trackpad behaves like the built-in one.
for domain in com.apple.AppleMultitouchTrackpad com.apple.driver.AppleBluetoothMultitouch.trackpad; do
  defaults write "$domain" Clicking -bool true
  defaults write "$domain" DragLock -int 0
  defaults write "$domain" Dragging -int 0
  defaults write "$domain" TrackpadThreeFingerDrag -bool false
  defaults write "$domain" TrackpadRightClick -bool true
  defaults write "$domain" TrackpadCornerSecondaryClick -int 0
  defaults write "$domain" TrackpadThreeFingerTapGesture -int 0
  defaults write "$domain" TrackpadTwoFingerDoubleTapGesture -int 1
  defaults write "$domain" TrackpadPinch -int 1
  defaults write "$domain" TrackpadRotate -int 1
  defaults write "$domain" TrackpadScroll -bool true
  defaults write "$domain" TrackpadHorizScroll -int 1
  defaults write "$domain" TrackpadMomentumScroll -bool true
  defaults write "$domain" TrackpadHandResting -bool true
  defaults write "$domain" TrackpadThreeFingerHorizSwipeGesture -int 2
  defaults write "$domain" TrackpadThreeFingerVertSwipeGesture -int 2
  defaults write "$domain" TrackpadFourFingerHorizSwipeGesture -int 2
  defaults write "$domain" TrackpadFourFingerVertSwipeGesture -int 2
  defaults write "$domain" TrackpadFourFingerPinchGesture -int 2
  defaults write "$domain" TrackpadFiveFingerPinchGesture -int 2
  defaults write "$domain" TrackpadTwoFingerFromRightEdgeSwipeGesture -int 3
  defaults write "$domain" USBMouseStopsTrackpad -int 0
done

# Force click off, silent clicking, lightest click firmness. Only the built-in
# trackpad has these; the Bluetooth domain has no such keys.
defaults write com.apple.AppleMultitouchTrackpad ForceSuppressed -bool true
defaults write com.apple.AppleMultitouchTrackpad ActuateDetents -int 0
defaults write com.apple.AppleMultitouchTrackpad FirstClickThreshold -int 1
defaults write com.apple.AppleMultitouchTrackpad SecondClickThreshold -int 1

# Tap to click and secondary click also have a global and a per-host copy;
# the login window and some panes read those instead of the driver domains.
defaults write NSGlobalDomain com.apple.mouse.tapBehavior -int 1
defaults -currentHost write NSGlobalDomain com.apple.mouse.tapBehavior -int 1
defaults write NSGlobalDomain com.apple.trackpad.enableSecondaryClick -bool true
defaults -currentHost write NSGlobalDomain com.apple.trackpad.enableSecondaryClick -bool true
defaults write NSGlobalDomain com.apple.trackpad.forceClick -bool false

# Pointer speed. Since macOS 26.1 System Settings no longer writes these keys
# itself, so the value is applied best-effort and read back at the end.
defaults write NSGlobalDomain com.apple.trackpad.scaling -float "$POINTER_SPEED"
defaults write NSGlobalDomain com.apple.mouse.scaling -float "$POINTER_SPEED"

# --- Screenshots -----------------------------------------------------------

defaults write com.apple.screencapture location -string "$HOME/Downloads"
defaults write com.apple.screencapture type -string png
defaults write com.apple.screencapture show-thumbnail -bool false

# --- Finder ----------------------------------------------------------------

defaults write com.apple.finder NewWindowTarget -string PfLo
defaults write com.apple.finder NewWindowTargetPath -string "file://$HOME/Downloads/"
# Column view everywhere. Downloads keeps its list view through the .DS_Store
# the 62-downloads-view script records; that is per-folder and wins over this
# default, so the two do not fight.
defaults write com.apple.finder FXPreferredViewStyle -string clmv
defaults write NSGlobalDomain AppleShowAllExtensions -bool true
defaults write com.apple.finder ShowStatusBar -bool true
defaults write com.apple.finder _FXSortFoldersFirst -bool true
defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true
defaults write com.apple.finder ShowHardDrivesOnDesktop -bool false
defaults write com.apple.finder ShowExternalHardDrivesOnDesktop -bool true
defaults write com.apple.finder ShowRemovableMediaOnDesktop -bool true
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode2 -bool true
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint -bool true
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint2 -bool true
defaults write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false

# The Desktop icon view is one dictionary, so -dict-add replaces the whole
# sub-dictionary. The captured keys left out here (showItemInfo, showIconPreview,
# backgroundType, the grid offsets) are Finder's own defaults, which it fills
# back in, so nothing is lost by writing only the four that differ plus the
# arrangement.
#
# The value is an XML fragment, not the old-style `{ key = value; }` syntax, in
# which every scalar would be a string. Finder stores the three sizes as reals
# and the label position as a boolean, so that is what is written.
defaults write com.apple.finder DesktopViewSettings -dict-add IconViewSettings \
  '<dict><key>arrangeBy</key><string>kind</string><key>iconSize</key><real>16</real><key>gridSpacing</key><real>100</real><key>textSize</key><real>14</real><key>labelOnBottom</key><false/></dict>'

# --- Window manager --------------------------------------------------------

# StandardHideDesktopIcons hides the desktop items in normal mode; HideDesktop
# only covers Stage Manager, which is why both are written.
defaults write com.apple.WindowManager EnableStandardClickToShowDesktop -bool false
defaults write com.apple.WindowManager StandardHideDesktopIcons -bool true
defaults write com.apple.WindowManager HideDesktop -bool true
defaults write com.apple.WindowManager StandardHideWidgets -bool true
# AppWindowGroupingBehavior is an integer in this domain; the other four are
# booleans, as read off this Mac.
defaults write com.apple.WindowManager StageManagerHideWidgets -bool false
defaults write com.apple.WindowManager AutoHide -bool false
defaults write com.apple.WindowManager EnableTiledWindowMargins -bool false
defaults write com.apple.WindowManager EnableTilingOptionAccelerator -bool false
defaults write com.apple.WindowManager AppWindowGroupingBehavior -int 1

# --- Dock ------------------------------------------------------------------

defaults write com.apple.dock autohide -bool true
defaults write com.apple.dock autohide-delay -float 0.5
defaults write com.apple.dock tilesize -int 16
defaults write com.apple.dock magnification -bool true
defaults write com.apple.dock largesize -int 128
defaults write com.apple.dock orientation -string bottom
defaults write com.apple.dock show-recents -bool false
defaults write com.apple.dock launchanim -bool false

# All four hot corners do nothing. What is in the Dock is a separate script.
for corner in tl tr bl br; do
  defaults write com.apple.dock "wvous-$corner-corner" -int 0
  defaults write com.apple.dock "wvous-$corner-modifier" -int 0
done

# --- Wallpaper -------------------------------------------------------------

# The wallpaper store records which provider drew the desktop, and reading it
# needs no permission. A solid colour is already what we want, so the System
# Events call (one Automation consent prompt on a fresh Mac) is skipped.
WALLPAPER_INDEX="$HOME/Library/Application Support/com.apple.wallpaper/Store/Index.plist"

wallpaper_provider() {
  [ -f "$WALLPAPER_INDEX" ] || return 0
  plutil -extract AllSpacesAndDisplays.Desktop.Content.Choices.0.Provider raw \
    -o - -- "$WALLPAPER_INDEX" 2>/dev/null || true
}

if [ "$(wallpaper_provider)" = com.apple.wallpaper.choice.color ]; then
  echo "defaults: the wallpaper is already a solid colour, leaving it alone"
elif osascript -e 'tell application "System Events" to set picture of every desktop to "/System/Library/Desktop Pictures/Solid Colors/Black.png"' >/dev/null 2>&1; then
  echo "defaults: wallpaper set to solid black"
else
  echo "defaults: could not set the wallpaper. Allow this terminal to control"
  echo "defaults: System Events (Privacy & Security > Automation), or pick"
  echo "defaults: Wallpaper > Colours > Black by hand."
fi

# --- Dictation -------------------------------------------------------------

defaults write com.apple.HIToolbox AppleDictationAutoEnable -int 1
defaults write com.apple.assistant.support "Dictation Enabled" -bool true
defaults write com.apple.speech.recognition.AppleSpeechRecognition.prefs \
  DictationIMPreferredLanguageIdentifiers -array en_US fr_CH de_CH

# The shortcut (press Control twice) is symbolic hotkey 164, whose second
# parameter is 18446744073709289471. `defaults write` cannot express a value
# that large, and editing the plist file behind cfprefsd's back loses the
# change, so the domain goes out through `defaults export`, through plistlib,
# and back in through `defaults import`.
if [ -x "$PYTHON" ]; then
  hotkeys="$(mktemp -d)"
  cat >"$hotkeys/edit.py" <<'PY'
import plistlib
import sys

# 262144 is the Control modifier mask. The second parameter is the captured
# value; it is 2**64 - 262145, which is why plistlib and a binary plist (the
# format macOS stores it in) are needed to round-trip it.
ENTRY = {
    "enabled": True,
    "value": {"parameters": [262144, 18446744073709289471], "type": "modifier"},
}

data = plistlib.loads(sys.stdin.buffer.read())
if not isinstance(data, dict):
    data = {}
hotkeys = data.get("AppleSymbolicHotKeys")
if not isinstance(hotkeys, dict):
    hotkeys = {}
    data["AppleSymbolicHotKeys"] = hotkeys
hotkeys["164"] = ENTRY
sys.stdout.buffer.write(plistlib.dumps(data, fmt=plistlib.FMT_BINARY))
PY
  if defaults export com.apple.symbolichotkeys - >"$hotkeys/in.plist" &&
    "$PYTHON" "$hotkeys/edit.py" <"$hotkeys/in.plist" >"$hotkeys/out.plist" &&
    defaults import com.apple.symbolichotkeys - <"$hotkeys/out.plist"; then
    echo "defaults: dictation shortcut set to pressing Control twice"
  else
    echo "defaults: could not write the dictation shortcut; set it in"
    echo "defaults: System Settings > Keyboard > Dictation > Shortcut."
  fi
  rm -rf "$hotkeys"
else
  echo "defaults: no $PYTHON, skipping the dictation shortcut"
fi

# --- Power -----------------------------------------------------------------

# pmset needs sudo, so every value is compared first: a re-run on a machine
# that is already set asks for nothing.
POWER="$(pmset -g custom 2>/dev/null || true)"

# pmset_value <block> <key>  -> the value pmset reports, empty when absent
pmset_value() {
  printf '%s\n' "$POWER" | awk -v block="$1" -v key="$2" '
    /^[^ \t]/ { section = $0; next }
    section ~ block && $1 == key { print $2; exit }
  '
}

# pmset_set <flag> <block> <key> <value>
pmset_set() {
  [ "$(pmset_value "$2" "$3")" != "$4" ] || return 0
  echo "defaults: pmset $1 $3 $4 (asks for the admin password)"
  sudo pmset "$1" "$3" "$4" ||
    echo "defaults: pmset $1 $3 failed; set it in System Settings > Battery"
}

pmset_set -c "AC Power" sleep 0
pmset_set -c "AC Power" displaysleep 10
pmset_set -b "Battery Power" displaysleep 15
pmset_set -b "Battery Power" lessbright 0

# --- Apply -----------------------------------------------------------------

# Re-reads the input settings as the logged-in user, which is what makes the
# keyboard, trackpad and pointer values take effect without a logout.
if [ -x "$ACTIVATE_SETTINGS" ]; then
  "$ACTIVATE_SETTINGS" -u || true
fi

killall Finder Dock SystemUIServer TextInputMenuAgent >/dev/null 2>&1 || true

# --- Pointer speed read-back -----------------------------------------------

# The defaults keys are written above, but since macOS 26.1 the pane no longer
# owns them, so whether the live value follows is checked rather than assumed.
pointer_now="$(pointer_speed_now)"
if [ "$pointer_now" = "$POINTER_HID" ]; then
  mark pointer-speed-applied "$POINTER_SPEED"
else
  # No marker, so the report at the end of the apply keeps listing this.
  rm -f "$STATE/pointer-speed-applied"
  echo "defaults: pointer speed is ${pointer_now:-unknown}, wanted $POINTER_HID"
  echo "defaults: (it was ${pointer_was:-unknown} before this run). Set the"
  echo "defaults: tracking speed by hand in System Settings > Trackpad."
fi

exit 0
