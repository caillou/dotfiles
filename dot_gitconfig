[user]
	name = Pierre Spring
	email = pierre.spring@caillou.ch
[pull]
	ff = only
[init]
	defaultBranch = main
[core]
	commentChar = |
# Last section wins, so the conditional include has to come after the default
# identity. Git matches the folder by path and never looks at the disk, so the
# first ICFM clone on a fresh Mac already carries the right address.
[includeIf "gitdir:~/repos/icfm/"]
	path = ~/.config/git/icfm.gitconfig
[push]
	autoSetupRemote = true
[rerere]
	enabled = true
# Written by `gh auth setup-git`, kept exactly as gh writes it (the empty
# helper line resets the osxkeychain default for these hosts; the gh path is
# absolute because that is what gh writes). gh rewrites these lines verbatim
# when asked again, so the file stays byte-identical and apply stays quiet.
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
